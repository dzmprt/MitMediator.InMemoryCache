<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>MitMediator.InMemoryCache</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>10.0.0</Version>
        <Title>MitMediator.InMemoryCache</Title>
        <Description>An attribute-driven in-memory caching extension for the MitMediator</Description>
        <PackageProjectUrl>https://github.com/dzmprt/MitMediator.InMemoryCache</PackageProjectUrl>
        <PackageTags>mediator;request;response;queries;commands;mitmediator;cqrs;memorycache;inmemorycache</PackageTags>
        <PackageReleaseNotes>v10.0.0
- Upgraded to .NET 10 and MitMediator 10.
- Moved the caching attribute to `MitMediator.InMemoryCache.Abstractions`; renamed `CacheResponse` to `CacheResponseInMemory` (**breaking change**).
- Improved cache synchronization and invalidation with striped locks, including generic request invalidation.</PackageReleaseNotes>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\assets\logo.png" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
        <PackageReference Include="MitMediator" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MitMediator.InMemoryCache.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MitMediator.InMemoryCache.Abstractions" />
    </ItemGroup>
</Project>